# PredictOps environment configuration.
# Copy to backend/.env and adjust. Every value below has a working default, so
# the application runs with no .env file at all.

DATABASE_URL=sqlite:///./predictops.db
MODEL_PATH=app/ml/model.joblib
ENVIRONMENT=development
DEMO_MODE=true

# How often the simulator writes a new reading for each machine.
LIVE_FEED_INTERVAL_SECONDS=15

# ─── AI ───────────────────────────────────────────────────────────────────────
# Which model phrases answers: auto | cortex | gemini | none
# "auto" prefers Snowflake Cortex, then Gemini, then the deterministic template.
# Cortex is preferred because the Gemini free tier allows only 20 requests PER DAY,
# which is reached in ordinary use and silently forces every answer to rule-based.
# No provider is required: the deterministic path is always correct and available.
LLM_PROVIDER=auto
CORTEX_MODEL=claude-sonnet-4-5

# Blank resolves from SNOWFLAKE_DEFAULT_CONNECTION_NAME, then connections.toml in
# file order. Connections needing a browser login (oauth_authorization_code,
# externalbrowser, username_password_mfa) are skipped while no token is cached: a
# server cannot complete that handshake, and attempting it blocks instead of failing
# (measured: 122s, then a browser window).
#
# If those are your only connections, run this ONCE:
#     cd backend; python -m app.llm.prime_cortex_login
# It completes the browser login and caches a reusable token in
# ~/.snowflake/predictops_token_cache, after which startup opens Cortex silently
# (measured: 10.0s with the prompt, 3.3s without). Naming a connection here
# overrides the guard regardless.
SNOWFLAKE_CONNECTION=

# Optional. Without a key, Gemini is simply not offered as a provider.
GEMINI_API_KEY=
# Use an alias rather than a pinned version: gemini-1.5-flash was retired and
# began returning 404 on every call.
GEMINI_MODEL=gemini-flash-latest

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Gates MUTATING endpoints only; reads stay open so dashboards cannot break.
# Ships disabled because the bundled UI has no login screen. Startup REFUSES to
# run with this false unless ENVIRONMENT is a development value, so a demo
# configuration cannot be deployed by accident.
AUTH_ENABLED=false

# Leave blank in development: a random key is generated once and persisted to
# backend/.secret_key (gitignored), so tokens survive a restart without a key
# being committed. Outside development this MUST be set or startup fails — a
# signing key published in the repository means anyone can mint a planner token.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared password for the seeded demo accounts. Startup refuses to run with this
# default outside development.
DEMO_PASSWORD=predictops

# ─── Request hardening ────────────────────────────────────────────────────────
# Browser origins allowed to call the API, comma-separated. NOT a wildcard: "*"
# cannot be combined with credentials, and it lets any page the user visits drive
# this API. "*" is honoured only in a development environment.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ceiling on a raw CSV request body. The body is buffered in memory and pandas
# expands it further, so an unbounded read is a single-request DoS.
MAX_UPLOAD_BYTES=8388608

# Per-client throttles. Login is both guessable and expensive (120k PBKDF2
# rounds); the LLM endpoints spend metered third-party quota per call.
RATE_LIMIT_ENABLED=true
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LLM_REQUEST_LIMIT=30
LLM_REQUEST_WINDOW_SECONDS=60

# Interface to bind when started with `python -m app.main`. Loopback by default:
# 0.0.0.0 publishes an API whose mutations are unauthenticated out of the box to
# the entire local network.
HOST=127.0.0.1
PORT=8000

# ─── Notifications ────────────────────────────────────────────────────────────
# POST target for Critical alerts. Empty means each attempt is recorded as
# "skipped" rather than silently dropped. Delivery failures never block alerting.
# Must be http or https; plain http is refused outside development. The URL is
# redacted to scheme and host in API responses, because an incoming-webhook path
# is itself a credential.
NOTIFICATION_WEBHOOK_URL=

# --- Reverse proxy -----------------------------------------------------------
# How many proxies in front of this process append to X-Forwarded-For.
# 0 = trust nothing, identify callers by peer address. Correct for local use.
# 1 = correct on Render, Railway, Fly and most single-proxy platforms. Without
#     it every visitor shares one rate-limit bucket, so a handful of users lock
#     out everyone else. Never set it higher than the number of proxies you
#     actually control: each extra hop is one more spoofable header entry.
TRUSTED_PROXY_HOPS=0

# --- Deployment (Render + Vercel) --------------------------------------------
# Values below are NOT defaults; they document what a deployment overrides.
# render.yaml sets these for you, except the two marked "dashboard only".
#
#   DATABASE_URL           Paste the provider's connection string verbatim. The
#                          legacy postgres:// scheme and ?sslmode=require are
#                          both rewritten by
#                          app.database.normalise_database_url, because
#                          SQLAlchemy 2.0 rejects the former and asyncpg the
#                          latter.
#
#                          SUPABASE — use the "Session pooler" string:
#                            postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#                          NOT "Direct connection" (db.<ref>.supabase.co): it is
#                          IPv6-only on current free projects and Render has no
#                          outbound IPv6, so it just times out.
#                          "Transaction pooler" (port 6543) also works — the app
#                          detects that port and disables asyncpg's server-side
#                          prepared statements, which transaction pooling cannot
#                          serve — but session mode needs no workaround.
#                          Percent-encode the password if it contains @ : / ? # &
#
#                          RENDER managed Postgres:
#                            postgres://user:pass@host/db?sslmode=require
#   ENVIRONMENT            production. This makes the startup guard refuse to
#                          boot with AUTH_ENABLED=false, DEMO_MODE=true, or the
#                          default DEMO_PASSWORD.
#   AUTH_ENABLED           true
#   DEMO_MODE              false
#   SECRET_KEY             dashboard only. Tokens signed with it survive
#                          restarts only if it is stable, so do not let the
#                          development branch generate an ephemeral one.
#   DEMO_PASSWORD          dashboard only. Judges sign in with planner /
#                          technician / viewer and this password.
#   TRUSTED_PROXY_HOPS     1
#   LLM_PROVIDER           gemini. Snowflake Cortex reads
#                          ~/.snowflake/connections.toml, which cannot exist on
#                          a PaaS instance, so Cortex is local-only. Pinning the
#                          provider makes that explicit rather than relying on
#                          "auto" to fail over.
#   GEMINI_API_KEY         dashboard only. Free tier is ~20 requests/day; past
#                          that every answer falls back to the deterministic
#                          template.
#   CORS_ALLOWED_ORIGINS   The exact Vercel origin, e.g.
#                          https://predictops.vercel.app. A wildcard is
#                          downgraded to localhost outside development.
#
# Frontend, set in Vercel's project settings at BUILD time (Vite inlines it):
#   VITE_API_BASE_URL      https://predictops-api.onrender.com
#                          Leaving it empty makes the browser call its own
#                          origin, which only works behind the Vite dev proxy.
